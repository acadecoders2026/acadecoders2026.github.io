! X colors.
! Generated by 'wal'
*foreground:        #c9c8c8
*background:        #272326
*.foreground:       #c9c8c8
*.background:       #272326
emacs*foreground:   #c9c8c8
emacs*background:   #272326
URxvt*foreground:   #c9c8c8
XTerm*foreground:   #c9c8c8
UXTerm*foreground:  #c9c8c8
URxvt*background:   [100]#272326
XTerm*background:   #272326
UXTerm*background:  #272326
URxvt*cursorColor:  #c9c8c8
XTerm*cursorColor:  #c9c8c8
UXTerm*cursorColor: #c9c8c8
URxvt*borderColor:  [100]#272326

! Colors 0-15.
*.color0: #272326
*color0:  #272326
*.color1: #A3929A
*color1:  #A3929A
*.color2: #D1B0B5
*color2:  #D1B0B5
*.color3: #D1B4CB
*color3:  #D1B4CB
*.color4: #D8B6D9
*color4:  #D8B6D9
*.color5: #E9BACA
*color5:  #E9BACA
*.color6: #F2CED2
*color6:  #F2CED2
*.color7: #c9c8c8
*color7:  #c9c8c8
*.color8: #7c6570
*color8:  #7c6570
*.color9: #A3929A
*color9:  #A3929A
*.color10: #D1B0B5
*color10:  #D1B0B5
*.color11: #D1B4CB
*color11:  #D1B4CB
*.color12: #D8B6D9
*color12:  #D8B6D9
*.color13: #E9BACA
*color13:  #E9BACA
*.color14: #F2CED2
*color14:  #F2CED2
*.color15: #c9c8c8
*color15:  #c9c8c8

! Black color that will not be affected by bold highlighting.
*.color66: #272326
*color66:  #272326

! Xclock colors.
XClock*foreground: #c9c8c8
XClock*background: #272326
XClock*majorColor:  rgba:c9/c8/c8/ff
XClock*minorColor:  rgba:c9/c8/c8/ff
XClock*hourColor:   rgba:c9/c8/c8/ff
XClock*minuteColor: rgba:c9/c8/c8/ff
XClock*secondColor: rgba:c9/c8/c8/ff

! Set depth to make transparency work.
URxvt*depth: 32
